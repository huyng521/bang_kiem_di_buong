# Sao chép file này thành ".env.local" rồi điền giá trị lấy từ Supabase Dashboard
# (Project Settings -> API).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon / public key (an toàn để lộ ra trình duyệt, bị giới hạn bởi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# service_role key (TUYỆT ĐỐI giữ bí mật, chỉ dùng ở server để admin tạo tài khoản).
# Khi deploy lên Vercel, thêm biến này trong Vercel Project Settings -> Environment
# Variables, KHÔNG bao giờ thêm tiền tố NEXT_PUBLIC_ cho biến này.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mật khẩu bảo vệ đường dẫn cron sinh thông báo (chuỗi ngẫu nhiên dài, tự đặt).
# Vercel Cron tự gửi kèm khi gọi. Tạo bằng: openssl rand -hex 32
CRON_SECRET=

# Địa chỉ web thật (dùng cho link trong email quên mật khẩu), ví dụ https://bang-kiem.vercel.app
NEXT_PUBLIC_SITE_URL=
